{
  "name": "physiocoach-ai-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 4300",
    "prebuild": "node scripts/write-runtime-config.mjs",
    "prepare": "husky || true",
    "sync:config": "node scripts/write-runtime-config.mjs",
    "prepush": "npm run sync:config",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "validate": "npm run lint && npm test && npm run build",
    "validate:core": "npm run lint && npm run build",
    "test": "node scripts/test.mjs",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript $API_OPENAPI_URL -o src/app/core/api/generated/schema.ts",
    "smoke:web": "node scripts/smoke.mjs",
    "smoke:web:dev": "node scripts/smoke.mjs --target=dev",
    "smoke:web:prod": "node scripts/smoke.mjs --target=prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.15",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@primeng/themes": "^21.0.4",
    "chart.js": "^4.5.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@rollup/rollup-darwin-arm64": "^4.60.4",
    "angular-eslint": "21.4.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
