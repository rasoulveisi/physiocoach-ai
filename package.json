{
  "name": "physiocoach-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "physiocoach-ai-api",
    "physiocoach-ai-web"
  ],
  "scripts": {
    "dev:api": "npm --workspace=physiocoach-ai-api run dev",
    "dev:web": "npm --workspace=physiocoach-ai-web run start",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
