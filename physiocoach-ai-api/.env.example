APP_ENV=local
AUTH_JWT_SECRET=replace-with-local-jwt-secret-at-least-32-chars
AUTH_ISSUER=physiocoach-ai-api
AUTH_AUDIENCE=physiocoach-ai-web
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_IDLE_DAYS=30
AUTH_REFRESH_ABSOLUTE_DAYS=60
GOOGLE_OAUTH_CLIENT_ID=replace-with-local-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-local-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/v1/auth/google/callback
OPENROUTER_API_KEY=replace-with-local-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WORKOUT_MODEL_PRIMARY=meta-llama/llama-3.3-70b-instruct
WORKOUT_MODEL_FALLBACKS=meta-llama/llama-3.1-8b-instruct,google/gemini-2.0-flash-001
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_MAX_RETRIES=0
CORS_ORIGIN=http://localhost:4200,http://localhost:8787
