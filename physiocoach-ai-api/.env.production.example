APP_ENV=production
AUTH_JWT_SECRET=set-in-cloudflare-secret
AUTH_ISSUER=physiocoach-ai-api
AUTH_AUDIENCE=physiocoach-ai-web
AUTH_ACCESS_TTL_SEC=900
AUTH_REFRESH_IDLE_DAYS=30
AUTH_REFRESH_ABSOLUTE_DAYS=60
GOOGLE_OAUTH_CLIENT_ID=set-in-cloudflare-secret
GOOGLE_OAUTH_CLIENT_SECRET=set-in-cloudflare-secret
GOOGLE_OAUTH_REDIRECT_URI=https://physiocoach-ai-api.otconnect.ir/api/v1/auth/google/callback
OPENROUTER_API_KEY=set-in-cloudflare-secret
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://physiocoach.otconnect.ir
OPENROUTER_TITLE=PhysioCoach AI
WORKOUT_MODEL_PRIMARY=meta-llama/llama-3.3-70b-instruct
WORKOUT_MODEL_FALLBACKS=meta-llama/llama-3.1-8b-instruct,google/gemini-2.0-flash-001
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_MAX_RETRIES=0
CORS_ORIGIN=https://physiocoach.otconnect.ir
