{
  "name": "physiocoach-ai-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.toml --remote --port 8787",
    "prepare": "husky || true",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:generate:openrouter": "vitest run tests/generate-api-openrouter.integration.test.ts --reporter=verbose",
    "test:integration": "vitest run tests/real-api.integration.test.ts --reporter=verbose",
    "lint": "eslint .",
    "validate": "npm run lint && npm test && npm run build",
    "format": "prettier --write src tests scripts package.json README.md docs",
    "format:check": "prettier --check src tests scripts package.json README.md docs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply physiocoach_prod --config ./wrangler.toml --local",
    "db:migrate:remote": "wrangler d1 migrations apply physiocoach_prod --config ./wrangler.toml --remote",
    "deploy": "wrangler deploy --config ./wrangler.toml",
    "openapi": "wrangler dev --test-scheduled=false",
    "smoke:api": "node scripts/smoke.mjs --target=prod",
    "check:catalog-runbook": "node scripts/check-exercise-catalog-runbook.mjs",
    "import:exercise-catalog": "node scripts/import-exercise-catalog.mjs",
    "import:exercises-dataset": "tsx scripts/import-exercises-dataset.mjs",
    "enrich:exercise-catalog": "tsx scripts/enrich-exercise-catalog.mjs",
    "analyze:exercise-safety": "tsx scripts/analyze-exercise-safety.mjs",
    "import:exercise-safety": "tsx scripts/import-exercise-safety.mjs",
    "prepare:licensed-media": "node scripts/prepare-licensed-exercise-media.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@cloudflare/workers-types": "^4.20260529.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/binding-wasm32-wasi": "1.0.2",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  }
}
