{
  "name": "physiocoach-ai-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.jsonc --remote --port 8787",
    "prepare": "husky || true",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:generate:openrouter": "vitest run tests/generate-api-openrouter.integration.test.ts --reporter=verbose",
    "test:integration": "vitest run tests/real-api.integration.test.ts --reporter=verbose",
    "lint": "eslint .",
    "validate": "npm run lint && npm test && npm run build",
    "format": "prettier --write src tests scripts package.json README.md docs",
    "format:check": "prettier --check src tests scripts package.json README.md docs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply physiocoach_prod --config ./wrangler.jsonc --local",
    "db:migrate:remote": "wrangler d1 migrations apply physiocoach_prod --config ./wrangler.jsonc --remote",
    "deploy": "wrangler deploy --config ./wrangler.jsonc",
    "openapi": "wrangler dev --test-scheduled=false",
    "smoke:api": "node scripts/smoke.mjs --target=prod",
    "check:catalog-runbook": "node scripts/check-exercise-catalog-runbook.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.0",
    "jose": "^6.2.3",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@cloudflare/workers-types": "^4.20260529.1",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  }
}
